# Environment: local | staging | production
# Controls backend, secrets source, and default SDK environment
NEXT_PUBLIC_ENV=local

# OAuth Configuration (Required)
NEXT_PUBLIC_CLIENT_ID=your_client_id_here

# CLIENT_SECRET is only required for local development
# In staging/production, it's fetched from AWS Secrets Manager:
# Secret name: vim-connect/{env}/demo-app
# Secret format: {"CLIENT_SECRET": "value"}
CLIENT_SECRET=your_client_secret_here

# ── Care Insights Mock App ────────────────────────────────────
# Separate OAuth app registered with redirect_uri: {APP_URL}/care-insights/app
# Register it at: {VIM_BACKEND_URL}/app-auth (same as demo-app, different client)
NEXT_PUBLIC_CARE_INSIGHTS_CLIENT_ID=your_care_insights_client_id_here

# CLIENT_SECRET for local dev only.
# Staging/prod: fetched from AWS Secrets Manager
# Secret name: vim-connect/{env}/care-insights-mock
# Secret format: {"CLIENT_SECRET": "value"}
CARE_INSIGHTS_CLIENT_SECRET=your_care_insights_client_secret_here

# SDK Environment Override (optional)
# Override which SDK to load (useful for local dev with staging SDK)
# Default: uses NEXT_PUBLIC_ENV
# Example: Use staging SDK while running backend locally
# NEXT_PUBLIC_SDK_ENV=staging

# Optional Overrides
# These are calculated from NEXT_PUBLIC_ENV by default:
#
# ENV=local:
#   VIM_BACKEND_URL → http://localhost:3000
#   APP_URL → window.location.origin or http://localhost:8080
#
# ENV=staging:
#   VIM_BACKEND_URL → https://api.stage.getvim.ai
#   APP_URL → window.location.origin or http://localhost:8080
#
# ENV=production:
#   VIM_BACKEND_URL → https://api.getvim.ai
#   APP_URL → window.location.origin or https://demo.getvim.ai
#
# Uncomment to override:
# NEXT_PUBLIC_VIM_BACKEND_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:8080
